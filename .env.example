# Copy to .env and fill in. .env is gitignored; never commit a real key.
GROQ_API_KEY=
# Optional
# GROQ_MODEL=openai/gpt-oss-120b   (any model from https://console.groq.com/docs/models)

# Optional: LangSmith tracing (https://smith.langchain.com). Every node, LLM call and retriever call becomes a trace.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=carefund
